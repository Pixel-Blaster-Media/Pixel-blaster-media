# ---- Supabase ----
# Public values (safe to ship to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Server-only — NEVER expose to the browser. Used by route handlers
# that need to bypass RLS (admin operations, webhook ingest, etc.).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# ---- Canonical media storage (Release 1; development only) ----
# Code-dark and disabled by default. These exact bucket names are isolated from
# production, remain private, and may contain synthetic test media only.
MEDIA_STORAGE_ENABLED=false
MEDIA_STORAGE_ENVIRONMENT=development
# Set exactly to development-synthetic-only only for an authorized live probe.
MEDIA_STORAGE_LIVE_PROBE_ACK=
# Cloudflare account ID and an R2 S3 token scoped only to the private
# development bucket below. Keep credentials server-side and out of chat/Git.
MEDIA_R2_ACCOUNT_ID=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
MEDIA_R2_BUCKET=pixel-blaster-dev-synthetic-media

# ---- iGuide (Phase 4) ----
# Portal REST API credentials. Create an API Token in the iGuide Portal
# under Settings → API Management → API Tokens. Scopes needed:
#   iguide.read, iguide.write, iguide.process, iguide.events, iguide.list
# Both values go straight into Vercel env vars — never paste into chat
# or git. Leave blank and the sync falls back to the public RESO
# autofill endpoint (alias-only, no historical backfill).
IGUIDE_API_BASE=https://manage.youriguide.com/api/v1
IGUIDE_APP_ID=
IGUIDE_APP_TOKEN=

# Long random string. Set this same value in your iGuide portal webhook
# config (append `?secret=<value>` to the webhook URL). The webhook
# handler refuses to process events without a matching secret.
# Generate one with: `openssl rand -hex 32`.
IGUIDE_WEBHOOK_SECRET=

# ---- Fotello (Phase 5) ----
# Base URL can be left blank to use the default
# (https://us-central1-real-estate-firebase-4109e.cloudfunctions.net).
# The API key is issued by Fotello support — email them once you're ready to
# integrate, then paste the key straight into Vercel env vars (never into
# chat, email, or git).
FOTELLO_API_BASE=
FOTELLO_API_KEY=

# ---- Autoenhance.ai ----
# Per-company values can also be saved in Admin -> Settings -> Integrations.
# Set the webhook URL shown there in Autoenhance's API settings, and use the
# same long random authentication value in both systems.
AUTOENHANCE_API_KEY=
AUTOENHANCE_WEBHOOK_SECRET=
# Optional. Leave blank unless Autoenhance support asks you to pin a version.
AUTOENHANCE_API_VERSION=

# ---- App ----
# Used in transactional emails and OAuth/magic-link redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Keep closed in production while Pixel Blaster is using this as its own
# booking system. Set to 1 only when public SaaS workspace signup is ready.
ENABLE_PUBLIC_SIGNUP=0

# ---- Email (Phase 2) ----
# Resend (or swap for Postmark/SendGrid). If left blank, the booking form
# still works end-to-end — sends are skipped with a console warning.
RESEND_API_KEY=
EMAIL_FROM="Pixel Blaster Media <bookings@pixelblastermedia.com>"

# Where new booking-request notifications are delivered to (you).
# Leave blank to skip the admin notification email.
ADMIN_NOTIFICATION_EMAIL=Info@PixelBlasterMedia.com

# ---- Cron authentication and scheduled recovery ----
# Long random string that authenticates the reminder and outbox cron routes.
# Vercel Cron sends it automatically as `Authorization: Bearer <configured-value>`
# when the environment variable exists. Both routes fail closed without it.
# Generate one with: `openssl rand -hex 32`.
CRON_SECRET=

# Scheduled outbox recovery is fail-closed and remains disabled unless this is
# exactly "true". Leave false until the additive recovery migration is applied
# and an operator has approved enabling provider mutations in that environment.
INTEGRATION_OUTBOX_DISPATCH_ENABLED=false
# Required when enabling dispatch. Use the reviewed UTC rollout cutoff; jobs
# created before this instant are never selected by scheduled recovery.
INTEGRATION_OUTBOX_DISPATCH_NOT_BEFORE=

# ---- Installed app notifications ----
# Optional Web Push keys for booking, cancellation, reschedule, delivery, and
# day-before alerts on phones that enabled notifications in Admin Settings.
# Generate one key pair with: `npx web-push generate-vapid-keys`
# Keep the private key server-only. VAPID_SUBJECT should be a mailto: address
# or an https: URL for the company operating this deployment.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com

# ---- QuickBooks Online (Phase 7) ----
# Create an app at https://developer.intuit.com and paste its keys here.
# Redirect URI to configure in the Intuit app dashboard:
#   ${NEXT_PUBLIC_APP_URL}/api/integrations/quickbooks/callback
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Set to 'sandbox' while testing against Intuit's sandbox company,
# 'production' when you're ready to create real invoices.
QUICKBOOKS_ENVIRONMENT=sandbox

# ---- Google Calendar (Phase 10) ----
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# and enable the Google Calendar API for the same project. Redirect URI to
# configure in the Google Cloud console:
#   ${NEXT_PUBLIC_APP_URL}/api/integrations/google-calendar/callback
# Optional: when Google has authorized a stable callback on a different app
# alias, set the exact URI here. OAuth still starts on NEXT_PUBLIC_APP_URL;
# the alias relays only code/state/error back there so session cookies stay on
# the canonical signed-in host. Token exchange uses this exact authorized URI.
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dedicated bearer secret for the event-read-only Hermes health endpoint.
# Generate independently with: `openssl rand -hex 32`.
GOOGLE_CALENDAR_WATCHDOG_SECRET=

# ---------------------------------------------------------------------------
# Google Maps / Places API — powers the /book property-step address
# autocomplete. Optional: if not set, the autocomplete gracefully falls back
# to a plain text field. Create at
# https://console.cloud.google.com/apis/credentials
# and enable both "Places API" and "Maps JavaScript API". Restrict the key
# to your domain (HTTP referrers) so it can't be reused elsewhere.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: enables realtor-facing AI copy drafts in the portal.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional: override only the admin command assistant model.
OPENAI_ASSISTANT_MODEL=gpt-5.4-mini
