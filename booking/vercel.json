{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/integration-outbox",
      "schedule": "5 21 * * *"
    }
  ]
}
