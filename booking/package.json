{
  "name": "pixel-blaster-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Pixel Blaster Media booking & client delivery portal (iGuide + Fotello integrations).",
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/verify-booking-login-link.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "node --test tests/*.test.mjs",
    "test:private-notes-ui": "node --import tsx --test tests/internal-shoot-notes-editor.behavior.mjs",
    "test:http-security": "node scripts/verify-security-http.mjs",
    "test:http-auth-dedup": "node scripts/verify-auth-request-deduplication-http.mjs",
    "test:postgres:atomic": "bash scripts/verify-atomic-booking-postgres.sh",
    "test:postgres:media": "bash scripts/verify-canonical-media-postgres.sh",
    "test:postgres:credentials": "bash scripts/verify-integration-credentials-postgres.sh",
    "verify:postgres:private-notes": "bash scripts/verify-private-booking-notes-postgres.sh",
    "test:postgres:catalog-examples": "bash scripts/verify-catalog-item-examples-postgres.sh",
    "verify:r2:development": "node scripts/verify-development-r2.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:setup": "bash scripts/generate-supabase-setup.sh",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "bootstrap:first-company": "tsx scripts/bootstrap-first-company.ts",
    "verify:auth-provisioning": "tsx scripts/verify-auth-provisioning.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1065.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "1.24.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "@types/web-push": "3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.26",
    "react-test-renderer": "^19.2.8",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.20.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "^8.5.26"
  }
}
