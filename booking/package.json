{
  "name": "pixel-blaster-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Pixel Blaster Media booking & client delivery portal (iGuide + Fotello integrations).",
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/verify-booking-login-link.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "node --test tests/*.test.mjs",
    "test:private-notes-ui": "node --import tsx --test tests/internal-shoot-notes-editor.behavior.mjs",
    "test:http-security": "node scripts/verify-security-http.mjs",
    "test:http-auth-dedup": "node scripts/verify-auth-request-deduplication-http.mjs",
    "test:postgres:tenant-search": "python3 scripts/verify-tenant-listing-search-postgres.py",
    "test:postgres:recovery": "python3 scripts/verify-lifecycle-recovery-postgres.py",
    "test:invoice": "node --import tsx --test lib/integrations/quickbooks/tests/*.test.mjs",
    "test:postgres:invoice": "bash lib/integrations/quickbooks/tests/verify-postgres.sh",
    "test:postgres:atomic": "bash scripts/verify-atomic-booking-postgres.sh",
    "test:postgres:finals-postgrest": "PF_REAL_POSTGREST=1 python3 scripts/verify-photo-finals-http.py",
    "test:postgres:finals-http": "python3 scripts/verify-photo-finals-http.py",
    "test:photo-finals:operator": "node --test tests/photo-finals-operator*.test.mjs && node --import tsx --test tests/photo-finals-operator-client.behavior.mjs && python3 scripts/verify-photo-finals-after-postgres.py",
    "test:photo-finals": "node --test tests/photo-finals-*.test.mjs",
    "test:postgres:finals-resource": "PF_PACKAGE_RESOURCE=1 python3 scripts/verify-photo-finals-packages.py",
    "test:postgres:finals-long-io": "PF_PACKAGE_LONG_IO=1 python3 scripts/verify-photo-finals-packages.py",
    "test:postgres:finals-packages": "python3 scripts/verify-photo-finals-packages.py",
    "test:postgres:finals-ingest": "python3 scripts/verify-photo-finals-ingest.py",
    "test:postgres:photo-finals": "python3 scripts/verify-photo-finals-concurrency.py",
    "test:postgres:media": "bash scripts/verify-canonical-media-postgres.sh",
    "test:postgres:credentials": "bash scripts/verify-integration-credentials-postgres.sh",
    "verify:postgres:private-notes": "bash scripts/verify-private-booking-notes-postgres.sh",
    "test:postgres:catalog-examples": "bash scripts/verify-catalog-item-examples-postgres.sh",
    "verify:r2:development": "node scripts/verify-development-r2.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:setup": "bash scripts/generate-supabase-setup.sh",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "bootstrap:first-company": "tsx scripts/bootstrap-first-company.ts",
    "verify:auth-provisioning": "tsx scripts/verify-auth-provisioning.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@noble/hashes": "2.4.0",
    "@smithy/node-http-handler": "^4.12.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "1.45.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@types/web-push": "3.6.4",
    "autoprefixer": "^10.6.0",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.5",
    "playwright": "1.63.0",
    "postcss": "^8.5.26",
    "react-test-renderer": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "postcss": "^8.5.26"
  }
}
