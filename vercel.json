{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(images|videos)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/book/",
      "destination": "/book",
      "permanent": false
    },
    {
      "source": "/portal/",
      "destination": "/portal",
      "permanent": false
    },
    {
      "source": "/auth/",
      "destination": "/auth",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/_next/:path*",
      "destination": "https://pixel-blaster-media.vercel.app/_next/:path*"
    },
    {
      "source": "/listings",
      "destination": "https://pixel-blaster-media.vercel.app/listings"
    },
    {
      "source": "/listings/:path*",
      "destination": "https://pixel-blaster-media.vercel.app/listings/:path*"
    },
    {
      "source": "/beta",
      "destination": "https://pixel-blaster-media.vercel.app/beta"
    },
    {
      "source": "/beta/:path*",
      "destination": "https://pixel-blaster-media.vercel.app/beta/:path*"
    },
    {
      "source": "/start",
      "destination": "https://pixel-blaster-media.vercel.app/start"
    },
    {
      "source": "/start/:path*",
      "destination": "https://pixel-blaster-media.vercel.app/start/:path*"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "https://pixel-blaster-media.vercel.app/manifest.webmanifest"
    },
    {
      "source": "/sw.js",
      "destination": "https://pixel-blaster-media.vercel.app/sw.js"
    },
    {
      "source": "/offline.html",
      "destination": "https://pixel-blaster-media.vercel.app/offline.html"
    },
    {
      "source": "/icons/:path*",
      "destination": "https://pixel-blaster-media.vercel.app/icons/:path*"
    },
    {
      "source": "/icon.png",
      "destination": "https://pixel-blaster-media.vercel.app/icon.png"
    },
    {
      "source": "/apple-icon.png",
      "destination": "https://pixel-blaster-media.vercel.app/apple-icon.png"
    },
    {
      "source": "/book",
      "destination": "https://pixel-blaster-media.vercel.app/book"
    },
    {
      "source": "/book/:path*",
      "destination": "https://pixel-blaster-media.vercel.app/book/:path*"
    },
    {
      "source": "/portal",
      "destination": "https://pixel-blaster-media.vercel.app/portal"
    },
    {
      "source": "/portal/:path*",
      "destination": "https://pixel-blaster-media.vercel.app/portal/:path*"
    },
    {
      "source": "/auth",
      "destination": "https://pixel-blaster-media.vercel.app/auth"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://pixel-blaster-media.vercel.app/auth/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://pixel-blaster-media.vercel.app/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://pixel-blaster-media.vercel.app/admin/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://pixel-blaster-media.vercel.app/api/:path*"
    }
  ]
}
