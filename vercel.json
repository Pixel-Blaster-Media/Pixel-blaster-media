{
  "rewrites": [
    {
      "source": "/book",
      "destination": "https://pixel-blaster-media.vercel.app/book"
    },
    {
      "source": "/book/:path*",
      "destination": "https://pixel-blaster-media.vercel.app/book/:path*"
    },
    {
      "source": "/portal",
      "destination": "https://pixel-blaster-media.vercel.app/portal"
    },
    {
      "source": "/portal/:path*",
      "destination": "https://pixel-blaster-media.vercel.app/portal/:path*"
    },
    {
      "source": "/auth",
      "destination": "https://pixel-blaster-media.vercel.app/auth"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://pixel-blaster-media.vercel.app/auth/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://pixel-blaster-media.vercel.app/_next/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://pixel-blaster-media.vercel.app/api/:path*"
    }
  ]
}
